#include <botan/internal/ec_inner_data.h>

namespace Botan {

namespace {

std::shared_ptr<EC_Group_Data> load_EC_group_info(const char* p_str,
                                                  const char* a_str,
                                                  const char* b_str,
                                                  const char* g_x_str,
                                                  const char* g_y_str,
                                                  const char* order_str,
                                                  const OID& oid) {
   BOTAN_ARG_CHECK(oid.has_value(), "load_EC_group_info OID must be set");

   const BigInt p(p_str);
   const BigInt a(a_str);
   const BigInt b(b_str);
   const BigInt g_x(g_x_str);
   const BigInt g_y(g_y_str);
   const BigInt order(order_str);

   return EC_Group_Data::create(p, a, b, g_x, g_y, order, oid, EC_Group_Source::Builtin);
}

}  // namespace

