
# Wrong tag
DER = 050100

# Empty OID
DER = 0600

# Leading zero byte in multibyte encoding
DER = 0603500180

# Truncated
DER = 060350018101

# Multibyte encoding that doesn't end with high bit cleared
DER = 060450018181

# Valid OID (1.2 followed by 128 arcs) but the 129 byte encoding exceeds our limit
DER = 0681812A0101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101

# Valid OID (2.25.10889035741470030830827987437816582766592) but the arc of 2^133 exceeds our limit
DER = 0615698180808080808080808080808080808080808000

